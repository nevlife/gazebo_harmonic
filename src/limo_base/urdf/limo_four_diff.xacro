<?xml version="1.0"?>
<robot name="limo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheelbase" value="0.2"/>
  <xacro:property name="track" value="0.13"/>
  <xacro:property name="wheel_radius" value="0.045"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_z" value="-0.1"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="2.1557"/>
      <inertia ixx="0.24" ixy="0" ixz="0"
               iyy="0.96" iyz="0" izz="0.96"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="file://$(find limo_base)/meshes/limo_base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.12 0.1"/>
      </geometry>
    </collision>
  </link>

  <xacro:macro name="limo_wheel" params="name x y roll axis">
    <link name="${name}_wheel_link">
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.01055" ixy="0" ixz="0"
                 iyy="0.00075" iyz="0" izz="0.01055"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find limo_base)/meshes/limo_wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 ${wheel_width / 2} 0" rpy="1.57 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="${roll} 0 0"/>
      <axis xyz="0 ${axis} 0"/>
      <dynamics damping="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:limo_wheel name="front_left" x="${wheelbase / 2}" y="${track / 2}" roll="0" axis="1"/>
  <xacro:limo_wheel name="rear_left" x="${-wheelbase / 2}" y="${track / 2}" roll="0" axis="1"/>
  <xacro:limo_wheel name="front_right" x="${wheelbase / 2}" y="${-track / 2}" roll="3.14159" axis="-1"/>
  <xacro:limo_wheel name="rear_right" x="${-wheelbase / 2}" y="${-track / 2}" roll="3.14159" axis="-1"/>

  <link name="laser_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
      <material name="limo_laser">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.016"/>
      </geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.103 0 -0.034"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.06 0.015"/>
      </geometry>
      <material name="limo_camera">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.06 0.015"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.084 0 0.03"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0"
               iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 -0.1"/>
  </joint>
</robot>
