<?xml version="1.0"?>
<robot name="scout_v2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheelbase" value="0.498"/>
  <xacro:property name="track" value="0.58306"/>
  <xacro:property name="wheel_radius" value="0.16459"/>
  <xacro:property name="wheel_width" value="0.11653"/>
  <xacro:property name="wheel_z" value="-0.0702"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="40.0"/>
      <inertia ixx="2.288641" ixy="0" ixz="0"
               iyy="5.103976" iyz="0" izz="3.431465"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find scout_base)/meshes/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.008"/>
      <geometry>
        <box size="0.925 0.38 0.21"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.035"/>
      <geometry>
        <box size="0.154 0.627 0.07"/>
      </geometry>
    </collision>
  </link>

  <xacro:macro name="scout_wheel" params="name x y roll">
    <link name="${name}_wheel_link">
      <inertial>
        <mass value="3.0"/>
        <inertia ixx="0.7171" ixy="0" ixz="0"
                 iyy="0.1361" iyz="0" izz="0.7171"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find scout_base)/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="${roll} 0 0"/>
      <axis xyz="0 -1 0"/>
      <dynamics damping="0.2"/>
    </joint>
  </xacro:macro>

  <xacro:scout_wheel name="front_left" x="${wheelbase / 2}" y="${track / 2}" roll="0"/>
  <xacro:scout_wheel name="rear_left" x="${-wheelbase / 2}" y="${track / 2}" roll="0"/>
  <xacro:scout_wheel name="front_right" x="${wheelbase / 2}" y="${-track / 2}" roll="3.14159"/>
  <xacro:scout_wheel name="rear_right" x="${-wheelbase / 2}" y="${-track / 2}" roll="3.14159"/>

  <link name="laser_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="scout_laser">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.18 0 0.16"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.08 0.04"/>
      </geometry>
      <material name="scout_camera">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.44 0 0.08"/>
  </joint>
</robot>
