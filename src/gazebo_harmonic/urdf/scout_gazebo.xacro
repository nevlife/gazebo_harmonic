<?xml version="1.0"?>
<robot name="scout_v2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find scout_base)/urdf/scout_v2.xacro"/>

  <xacro:macro name="scout_wheel_surface" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>0.8</mu2>
      <kp>10000000.0</kp>
      <kd>1.0</kd>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>

  <xacro:scout_wheel_surface link="front_left_wheel_link"/>
  <xacro:scout_wheel_surface link="rear_left_wheel_link"/>
  <xacro:scout_wheel_surface link="front_right_wheel_link"/>
  <xacro:scout_wheel_surface link="rear_right_wheel_link"/>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel</left_joint>
      <left_joint>rear_left_wheel</left_joint>
      <right_joint>front_right_wheel</right_joint>
      <right_joint>rear_right_wheel</right_joint>
      <wheel_separation>0.58306</wheel_separation>
      <wheel_radius>0.16459</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/scout/odometry</odom_topic>
      <tf_topic>/scout/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <min_velocity>-3.0</min_velocity>
      <max_velocity>3.0</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/scout/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor name="laser_sensor" type="gpu_lidar">
      <topic>/scout/scan</topic>
      <update_rate>8</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-2.09439504</min_angle>
            <max_angle>2.09439504</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="rgbd_camera">
      <topic>/scout/camera</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>8.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
</robot>
